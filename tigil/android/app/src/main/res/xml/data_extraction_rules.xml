<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing about this app should leave the device or ride a cloud backup.
  Restoring "protection was on" onto a different phone would be misleading,
  and the blocked-attempt counter is nobody's business but the user's.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
